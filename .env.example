# DNS listens on loopback by default: safe for local experiments.
DNS_HOST=127.0.0.1
DNS_PORT=5353
# API is also local-only by default.
API_HOST=127.0.0.1
API_PORT=8000
UPSTREAM_DNS=1.1.1.1
UPSTREAM_PORT=53
UPSTREAM_TIMEOUT_SECONDS=2.0
DATABASE_PATH=./data/minihole.db
BLOCKLIST_PATH=./data/blocklist.txt
ALLOWLIST_PATH=./data/allowlist.txt
CACHE_MAX_ENTRIES=10000
LOG_RETENTION_DAYS=30
DEMO_MODE=true
